{
  "name": "weather-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:release": "npm run build && npm run scan:dist",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:live": "vitest run --config vitest.live.config.ts --reporter=verbose --disableConsoleIntercept",
    "test:browser": "playwright test",
    "test:browser:release": "playwright test --project=release-edge --project=release-chrome",
    "scan:dist": "node scripts/scanDist.mjs",
    "scan:dist:demo": "node scripts/scanDist.mjs --allow-demo",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
