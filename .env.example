# Names of the environment variables the build reads. Names only: no values are committed.
# Copy to .env.local (ignored by git, as are .env and .env.*) and fill in only what you need.
# Never put a credential in a VITE_* variable: Vite copies those into the public bundle.
# The default weather provider (Open-Meteo, non-commercial) needs no API key.

# Path the built site is served under: "/" or a plain path such as "/weather/".
# Unset or empty means "/". Read by vite.config.ts through scripts/baseUrl.mjs.
VITE_BASE=
